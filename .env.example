# Local EmDash encryption key (keep the existing value in .env).
EMDASH_ENCRYPTION_KEY=

# Optional public reCAPTCHA v3 site key. The matching RECAPTCHA_SECRET_KEY
# belongs in the ignored .dev.vars file or Cloudflare Worker secrets.
PUBLIC_RECAPTCHA_SITE_KEY=

# Put ZEPTOMAIL_API_TOKEN and OTP_SIGNING_SECRET in .dev.vars for local email.
# Never commit real tokens. Production uses `wrangler secret put`.
