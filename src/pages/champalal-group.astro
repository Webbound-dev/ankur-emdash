---
import { getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChampalalGroup from '../ui/components/ChampalalGroup.astro';
const content = await getPage('champalal-group');
---
<BaseLayout title={content.seo.title} description={content.seo.description} image={content.seo.image}>
  <ChampalalGroup content={content} />
</BaseLayout>
