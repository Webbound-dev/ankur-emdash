---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetail from '../../ui/components/ProductDetail.astro';
import type { Product } from '../../ui/components/ProductDetail.astro';
import { getProduct } from '../../lib/content';
import { buildProductSchema } from '../../lib/structuredData';

const { slug } = Astro.params;
const product = slug ? await getProduct<Product>(slug) : undefined;
if (!product) return Astro.rewrite('/404');

const productSchema = buildProductSchema(product, Astro.site);
---

<BaseLayout title={product.pageTitle} description={product.metaDescription} image={product.image?.src}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <ProductDetail product={product} />
</BaseLayout>
