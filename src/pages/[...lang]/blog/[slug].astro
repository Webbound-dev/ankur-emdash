---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogDetail from '../../../ui/components/BlogDetail.astro';
import type { BlogPost } from '../../../ui/components/BlogList.astro';
import { cmsList, cmsScope, getBlogs, getPage } from '../../../lib/content';
import { buildArticleSchema, toJsonLd } from '../../../lib/structuredData';

const content = await getPage('blog');
const posts = (await getBlogs()) as BlogPost[];

const { slug } = Astro.params;
const post = posts.find((p) => p.slug === slug);
if (!post) return Astro.rewrite('/404/');

// seoTitle/metaDescription are optional per-post overrides for posts whose
// on-page title or excerpt is too long for a search result (~60/~155 chars).
const title = post.seoTitle ?? `${post.title} | Ankur Salt`;
const description = post.metaDescription ?? post.excerpt;

const articleSchema = buildArticleSchema(post, Astro.site);
---
<BaseLayout title={title} description={description} image={post.image} type="article" preloadImage={post.image} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: post.title }]} seoFrom={post} cms={cmsScope(content, cmsList('', posts))}>
  {articleSchema && <script type="application/ld+json" set:html={toJsonLd(articleSchema)} />}
  <BlogDetail content={content} posts={posts} slug={slug!} />
</BaseLayout>
