---
import { toLocale } from '../../lib/i18n';
import { cmsScope, getDistributors, getPage } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DistributorNetwork from '../../ui/components/DistributorNetwork';
import DistributorFormsTabs from '../../ui/components/DistributorFormsTabs.astro';
const locale = toLocale(Astro.currentLocale);
const content = await getPage('network');
const distributors = await getDistributors();
---
<BaseLayout title={content.seo.title} description={content.seo.description} image={content.seo.image} seoFrom={content} cms={cmsScope(content)}>
  <main>
    <DistributorNetwork locale={locale} client:load content={content} distributors={distributors} />
    <DistributorFormsTabs content={content} />
  </main>
</BaseLayout>
