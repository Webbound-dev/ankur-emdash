---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductDetail from '../../../ui/components/ProductDetail.astro';
import type { Product } from '../../../ui/components/ProductDetail.astro';
import { cmsScope, getProduct } from '../../../lib/content';
import { buildFaqSchema, buildProductSchema, toJsonLd } from '../../../lib/structuredData';

const { slug } = Astro.params;
const product = slug ? await getProduct<Product>(slug) : undefined;
if (!product) return Astro.rewrite('/404');

const productSchema = buildProductSchema(product, Astro.site);
const faqSection = product.detail.sections.find(
  (section): section is Extract<typeof section, { type: 'faq' }> => section.type === 'faq'
);
const faqSchema = faqSection ? buildFaqSchema(faqSection.items) : null;
---

<BaseLayout title={product.pageTitle} description={product.metaDescription} image={product.image?.src} preloadImage={product.heroImage?.src ?? product.image?.src} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Consumable Salt', href: '/products/' }, { label: product.name }]} seoFrom={product} cms={cmsScope(product)}>
  <script type="application/ld+json" set:html={toJsonLd(productSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={toJsonLd(faqSchema)} />}
  <ProductDetail product={product} />
</BaseLayout>
