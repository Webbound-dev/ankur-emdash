---
import { cmsScope, getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildFaqSchema, toJsonLd } from '../lib/structuredData';
import Export from '../ui/components/Export.astro';
const content = await getPage('export');
const faqSchema = content.faq ? buildFaqSchema(content.faq.items) : null;
---
<BaseLayout title={content.seo.title} description={content.seo.description} image={content.seo.image} seoFrom={content} cms={cmsScope(content)}>
  {faqSchema && <script type="application/ld+json" set:html={toJsonLd(faqSchema)} />}
  <Export content={content} />
</BaseLayout>
