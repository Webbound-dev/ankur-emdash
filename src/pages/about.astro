---
import { getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutUs from '../ui/components/AboutUs.astro';
const content = await getPage('about');
---
<BaseLayout title={content.seo.title} description={content.seo.description} image={content.seo.image}>
  <AboutUs content={content} />
  
</BaseLayout>
