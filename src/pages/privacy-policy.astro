---
import { cmsScope, getPage } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../ui/components/LegalPage.astro';
const content = await getPage('privacy-policy');
---
<BaseLayout title={content.seo.title} description={content.seo.description} seoFrom={content} cms={cmsScope(content)}>
  <LegalPage content={content} />
</BaseLayout>
