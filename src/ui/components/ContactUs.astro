              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50">{t(locale, 'Please specify your grade')}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M12 1.5 21 12 12 22.5 3 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                <input type="text" id="contact-grade-other" name="gradeOther" class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder="e.g. Custom 90 PPM" />
              </div>
            </label>
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="industrial.fields.quantity">{industrial.fields.quantity}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M12 3v2M7 5h10l2 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L7 5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                <input type="text" name="quantity" required class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder="e.g. 20 MT / month" />
              </div>
            </label>
            <label class="block sm:col-span-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="industrial.fields.location">{industrial.fields.location}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><circle cx="12" cy="9" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
                <input type="text" name="location" required class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder={t(locale, 'City, state / country')} />
              </div>
            </label>
            <label class="block sm:col-span-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="industrial.fields.email">{industrial.fields.email}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M3 5h18v14H3V5Z M3 5l9 8 9-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                <input type="email" name="email" required class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder="you@company.com" />
              </div>
            </label>
            <label class="block sm:col-span-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50">07 · Attachment (Optional)</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M17.5 6.5 9 15a3 3 0 0 0 4.24 4.24l8-8a5 5 0 0 0-7.07-7.07l-8 8a7 7 0 0 0 9.9 9.9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <input
                  type="file"
                  name="attachment"
                  accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                  class="w-full rounded-lg border border-indian-red/15 bg-white py-2 pl-10 pr-3.5 text-sm text-indian-red/70 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30 file:mr-3 file:rounded-md file:border-0 file:bg-indian-red/[0.08] file:px-3 file:py-1.5 file:text-xs file:font-semibold file:uppercase file:tracking-wide file:text-indian-red hover:file:bg-indian-red/[0.14]"
                />
              </div>
              <p class="mt-1.5 text-[11px] text-indian-red/40">PDF, Word doc, or image, up to 10MB — spec sheet, drawing, or purchase order.</p>
            </label>
            <label class="block sm:col-span-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="industrial.fields.message">{industrial.fields.message}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-3 h-4 w-4 text-indian-red/35"><path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H8l-5 4V6a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                <textarea name="message" rows="3" class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder={t(locale, 'Any additional details about your requirement')}></textarea>
              </div>
            </label>
          </div>

          <button id="industrial-submit" type="submit" class="mt-7 inline-flex items-center justify-center gap-2 rounded-full bg-indian-red px-6 py-3 text-sm font-medium text-silent-white transition-transform duration-200 hover:scale-[1.03] disabled:opacity-70 disabled:cursor-not-allowed disabled:hover:scale-100">
            <span id="industrial-submit-label" data-cms-field="industrial.submitLabel">{industrial.submitLabel}</span>
            <svg viewBox="0 0 24 24" class="h-4 w-4"><path d="M5 12h14m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>

          <p id="industrial-success" class="mt-4 hidden text-sm font-medium text-indian-red" data-cms-field="industrial.successMessage">{industrial.successMessage}</p>
          <p id="industrial-error" class="mt-4 hidden text-sm font-medium text-red-600"></p>
        </div>
      </form>
    </div>
  </section>

  <!-- Distributor Inquiry — a short quick-capture form, then straight through to the full application -->
  <section id="panel-distributor" role="tabpanel" aria-labelledby="tab-distributor" data-panel="distributor" class="contact-panel">
    <BecomeDistributorForm locale={locale} client:load content={becomeDistributor} skipEntranceAnimation />
  </section>

  <section id="panel-connect-distributor" role="tabpanel" aria-labelledby="tab-connect-distributor" data-panel="connect-distributor" class="contact-panel">
    <ConnectWithDistributorForm locale={locale} client:load content={connectWithDistributor} skipEntranceAnimation />
  </section>

  <!-- Export Inquiry -->
  <section id="panel-export" role="tabpanel" aria-labelledby="tab-export" data-panel="export" class="contact-panel">
    <ExportInquiryForm locale={locale} client:load content={exportInquiry} cmsPath="exportInquiry" skipEntranceAnimation />
  </section>

  <!-- Find Us — sits between two other red bands (Export's form above and
       the newsletter CTA below in the footer), so keeping it Indian Red too
       made it disappear into them as one undifferentiated block. Inverted
       to Silent White with Indian Red content instead — the brand kit's
       other documented pairing — so it reads as its own panel and the
       red/cream/red rhythm actually shows. Background texture is the same
       pinstripe overlay this file already uses on its other light-bg
       sections (see the Contact info / Bulk & Industrial panels above)
       rather than a one-off pattern, so it stays consistent site-wide. -->
  <section class="relative overflow-hidden bg-silent-white py-16 lg:py-20 text-center">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.05]"
      style="background-image: repeating-linear-gradient(90deg, #A82121 0, #A82121 1px, transparent 1px, transparent 28px);"
      aria-hidden="true"
    />
    <div class="relative max-w-[640px] mx-auto px-6">
      <div class="est-badge mx-auto flex h-20 w-20 rotate-[8deg] items-center justify-center rounded-full border-[1.5px] border-dashed border-indian-red/40 bg-indian-red/[0.04] shadow-sm">
        <div class="text-center">
          <p class="font-display text-[9px] font-semibold uppercase tracking-[0.15em] text-indian-red">{t(locale, 'Est.')}</p>
          <p class="font-display text-lg font-semibold text-indian-red" data-cms-field="visit.since">{visit.since}</p>
        </div>
      </div>
      <h2 class="reveal mt-6 font-display font-medium text-2xl lg:text-3xl text-indian-red" data-cms-field="visit.heading">
        {visit.heading}
      </h2>
      <p class="reveal mt-3 text-sm leading-relaxed text-indian-red/70" style="transition-delay: 60ms" data-cms-field="visit.text">
        {visit.text}
      </p>
    </div>
  </section>
</main>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .nav-pill.active {
    color: #a82121;
  }
  .contact-panel {
    display: none;
  }
  .contact-panel.active {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { pageLocale, t } from '../../lib/ui-strings';
  import gsap from 'gsap';
  import { getRecaptchaToken } from '../lib/recaptcha';

  // initContactPage runs on `astro:page-load` (fires on initial load AND
  // every client-side transition) rather than as plain top-level code —
  // this <script> is a JS module, and modules only ever execute once per
  // browser session, so a plain top-level run left every `.reveal` element
  // permanently invisible (and the tab switching / forms never wired up) on
  // any revisit later in the same session. revealObserver/badgeObserver are
  // disconnected at the top of each run so a revisit replaces them instead
  // of layering a second observer on top; element listeners (tabs, forms,
  // card hover) don't need the same treatment since Astro's transition
  // replaces those DOM nodes outright, so stale listeners on the old,
  // now-detached elements are just garbage collected. The one exception is
  // `window.addEventListener('load', ...)` below, which only ever fires
  // once per real page load anyway (not per transition), so it's harmless
  // to leave unremoved even though `window` itself persists.
  let revealObserver: IntersectionObserver | null = null;
  let badgeObserver: IntersectionObserver | null = null;
  // Unlike revealObserver/badgeObserver above, this listens on `window`
  // itself — which Astro's transitions don't replace the way they replace
  // DOM nodes — so it needs the same explicit remove-before-add treatment
  // or it would stack a duplicate listener (and a duplicate toggle) on
  // every revisit.
  let onCustomSelectChange: EventListener | null = null;

  function initContactPage(): void {
    revealObserver?.disconnect();
    badgeObserver?.disconnect();
    if (onCustomSelectChange) window.removeEventListener('customselect:change', onCustomSelectChange);

    const targets = document.querySelectorAll<HTMLElement>('.reveal');
    if (targets.length) {
      revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              revealObserver?.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );
      targets.forEach((el) => revealObserver?.observe(el));
    }

    // The "Est." seal stamps in with a little bounce the first time it scrolls into view.
    // Default markup renders it fully visible — this only ever hides-then-reveals via JS,
    // so nothing depends on the animation firing.
    const estBadge = document.querySelector<HTMLElement>('.est-badge');
    if (estBadge) {
      badgeObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              gsap.fromTo(
                estBadge,
                { opacity: 0, scale: 0.5, rotate: -20 },
                { opacity: 1, scale: 1, rotate: 8, duration: 0.6, ease: 'back.out(1.8)' }
              );
              badgeObserver?.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );
      badgeObserver.observe(estBadge);
    }

    // Info card seal icons give a little bounce-and-tilt on hover, same as the
    // industry cards on the Industrial Salt page.
    document.querySelectorAll<HTMLElement>('.info-card').forEach((card) => {
      const icon = card.querySelector<HTMLElement>('.info-icon');
      if (!icon) return;
      card.addEventListener('mouseenter', () => {
        gsap.to(icon, { rotate: -8, scale: 1.15, duration: 0.35, ease: 'back.out(2.5)' });
      });
      card.addEventListener('mouseleave', () => {
        gsap.to(icon, { rotate: 0, scale: 1, duration: 0.3, ease: 'power2.out' });
      });
    });

    // Tab switching — only the selected inquiry's panel is shown at a time, with a
    // sliding pill behind the active tab and a crossfade between panels.
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    const navIndicator = document.getElementById('nav-indicator');
    const validIds = new Set(Array.from(tabs).map((t) => t.dataset.tab));

    const moveIndicator = (id: string, animate: boolean) => {
      const btn = document.getElementById(`tab-${id}`);
      if (!btn || !navIndicator) return;
      const { offsetLeft, offsetWidth } = btn;
      if (animate) {
        gsap.to(navIndicator, { x: offsetLeft, width: offsetWidth, duration: 0.35, ease: 'power2.out' });
      } else {
        gsap.set(navIndicator, { x: offsetLeft, width: offsetWidth });
      }
    };

    const switchPanel = (id: string, animate: boolean) => {
      const next = document.querySelector<HTMLElement>(`[data-panel="${id}"]`);
      const current = document.querySelector<HTMLElement>('.contact-panel.active');
      if (!next || current === next) return;

      const revealNext = () => {
        next.classList.add('active');
        if (!animate) return;
        gsap.fromTo(next, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' });
        const seal = next.querySelector<HTMLElement>('.panel-seal');
        if (seal) {
          gsap.fromTo(
            seal,
            { opacity: 0, scale: 0.5, rotate: -15 },
            { opacity: 1, scale: 1, rotate: 0, duration: 0.5, ease: 'back.out(2.2)', delay: 0.08 }
          );
        }
      };

      if (current && animate) {
        gsap.to(current, {
          opacity: 0,
          y: -10,
          duration: 0.2,
          ease: 'power1.in',
          onComplete: () => {
            current.classList.remove('active');
            gsap.set(current, { clearProps: 'opacity,transform' });
            revealNext();
          },
        });
      } else {
        current?.classList.remove('active');
        revealNext();
      }
    };

    const activateTab = (id: string, { animate = true, focusPanel = false } = {}) => {
      if (!validIds.has(id)) return;
      tabs.forEach((tab) => {
        const isActive = tab.dataset.tab === id;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      moveIndicator(id, animate);
      switchPanel(id, animate);
      if (focusPanel) {
        document.getElementById(`panel-${id}`)?.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.tab;
        if (!id) return;
        history.replaceState(null, '', `#${id}`);
        activateTab(id, { animate: true, focusPanel: true });
      });
    });

    const hashId = location.hash.replace('#', '');
    const initialId = validIds.has(hashId) ? hashId : 'general';
    activateTab(initialId, { animate: false });
    // Recalibrate the indicator once more after web fonts settle, in case tab widths shifted.
    window.addEventListener('load', () => moveIndicator(initialId, false));

    // "Other" in the Industrial tab's Industry/Grade dropdowns reveals a
    // free-text field — required only while visible, so a hidden field
    // doesn't silently block submit when a listed option is picked instead.
    // These are CustomSelect islands (not native <select>s), so there's no
    // `change` event on the form to listen to — CustomSelect dispatches its
    // own 'customselect:change' on window instead whenever a pick is made.
    const industryOtherWrap = document.getElementById('contact-industrial-other-wrap');
    const industryOtherInput = document.getElementById('contact-industrial-other') as HTMLInputElement | null;
    const gradeOtherWrap = document.getElementById('contact-grade-other-wrap');
    const gradeOtherInput = document.getElementById('contact-grade-other') as HTMLInputElement | null;
    onCustomSelectChange = ((e: CustomEvent<{ name: string; value: string }>) => {
      if (e.detail?.name === 'industry') {
        const isOther = e.detail.value === 'Other';
        industryOtherWrap?.classList.toggle('hidden', !isOther);
        if (industryOtherInput) industryOtherInput.required = isOther;
      } else if (e.detail?.name === 'grade') {
        const isOther = e.detail.value === 'Other';
        gradeOtherWrap?.classList.toggle('hidden', !isOther);
        if (gradeOtherInput) gradeOtherInput.required = isOther;
      }
    }) as EventListener;
    window.addEventListener('customselect:change', onCustomSelectChange);

    const forms: Array<{ formId: string; successId: string; errorId: string; submitId: string; labelId: string; endpoint: string; action: string; multipart?: boolean }> = [
      { formId: 'general-form', successId: 'general-success', errorId: 'general-error', submitId: 'general-submit', labelId: 'general-submit-label', endpoint: '/api/submit-contact-general', action: 'contact_general' },
      { formId: 'industrial-form', successId: 'industrial-success', errorId: 'industrial-error', submitId: 'industrial-submit', labelId: 'industrial-submit-label', endpoint: '/api/submit-contact-industrial', action: 'contact_industrial', multipart: true },
    ];
    const apiBase = import.meta.env.PUBLIC_OTP_API_BASE_URL ?? '';
    for (const { formId, successId, errorId, submitId, labelId, endpoint, action, multipart } of forms) {
      const form = document.getElementById(formId) as HTMLFormElement | null;
      const success = document.getElementById(successId);
      const errorEl = document.getElementById(errorId);
      const submitBtn = document.getElementById(submitId) as HTMLButtonElement | null;
      const labelEl = document.getElementById(labelId);
      const originalLabel = labelEl?.textContent ?? '';

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn?.disabled) return;
        errorEl?.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = true;
        if (labelEl) labelEl.textContent = t(pageLocale(), 'Submitting…');
        try {
          const recaptchaToken = await getRecaptchaToken(action);
          // The industrial form carries an optional file attachment, so it's
          // sent as multipart FormData (no Content-Type set — the browser
          // fills in the correct boundary); every other form here is plain
          // text fields, sent as JSON like the rest of the site's forms.
          let res: Response;
          if (multipart) {
            const formData = new FormData(form);
            formData.set('recaptchaToken', recaptchaToken);
            res = await fetch(`${apiBase}${endpoint}`, { method: 'POST', body: formData });
          } else {
            res = await fetch(`${apiBase}${endpoint}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ...Object.fromEntries(new FormData(form).entries()), recaptchaToken }),
            });
          }
          const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
          if (!res.ok || !data.ok) throw new Error(data.error || t(pageLocale(), 'Failed to submit'));
          if (success) {
            success.classList.remove('hidden');
            gsap.fromTo(success, { opacity: 0, y: -6 }, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' });
          }
          form.reset();
          // form.reset() only touches native form controls — CustomSelect's
          // own displayed value is separate React state it doesn't reach —
          // but the reveal-field's hidden/required state is plain DOM here,
          // and would otherwise still reflect whatever was chosen before
          // this submit.
          if (formId === 'industrial-form') {
            industryOtherWrap?.classList.add('hidden');
            if (industryOtherInput) industryOtherInput.required = false;
            gradeOtherWrap?.classList.add('hidden');
            if (gradeOtherInput) gradeOtherInput.required = false;
          }
        } catch (err) {
          if (errorEl) {
            errorEl.textContent = err instanceof Error ? err.message : t(pageLocale(), 'Failed to submit');
            errorEl.classList.remove('hidden');
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (labelEl) labelEl.textContent = originalLabel;
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initContactPage);
</script>
