---
import { toLocale } from '../../lib/i18n';
import { t } from '../../lib/ui-strings';
import CustomSelect from './CustomSelect';
import BecomeDistributorForm from './BecomeDistributorForm';
import type { BecomeDistributorContent } from './BecomeDistributorForm';
import ConnectWithDistributorForm from './ConnectWithDistributorForm';
import type { ConnectWithDistributorContent } from './ConnectWithDistributorForm';
import ExportInquiryForm from './ExportInquiryForm';
import type { ExportInquiryContent } from './ExportInquiryForm';
const locale = toLocale(Astro.currentLocale);

interface InfoItem { label: string; value: string; description: string; href?: string }
interface NavItem { id: string; label: string }

interface FormCard { ref: string; title: string; body: string; note: string }

interface Props {
  content: {
    hero: { title: string; intro: string };
    info: { heading: string; items: InfoItem[] };
    nav: { items: NavItem[] };
    general: {
      heading: string; subheading: string; card: FormCard;
      fields: { name: string; email: string; city: string; state: string; subject: string; message: string };
      subjectOptions: string[];
      submitLabel: string; successMessage: string;
    };
    industrial: {
      heading: string; subheading: string; linkLabel: string; linkHref: string; card: FormCard;
      fields: { company: string; industry: string; grade: string; quantity: string; location: string; email: string; message: string };
      submitLabel: string; successMessage: string;
    };
    // Same component (and same look/OTP-verified email/submit endpoint) as
    // the standalone Network page's Become a Distributor form — reused here
    // rather than hand-rolled, so the two never visually or behaviorally
    // drift apart again.
    becomeDistributor: BecomeDistributorContent;
    // Same component (and same look/OTP-verified email/submit endpoint) as
    // the standalone Network page's Connect with a Distributor form.
    connectWithDistributor: ConnectWithDistributorContent;
    // Same component (and same look/OTP-verified email/submit endpoint) as
    // the standalone Export page's inquiry form — reused here rather than
    // hand-rolled, so the two never visually or behaviorally drift apart again.
    exportInquiry: ExportInquiryContent;
    productOptions: { industries: string[]; grades: string[] };
    visit: { heading: string; text: string; since: string };
  };
}

const { content } = Astro.props;
const { hero, info, nav, general, industrial, becomeDistributor, connectWithDistributor, exportInquiry, productOptions, visit } = content;

const ICONS = {
  subject: 'M4 6h16M4 12h16M4 18h10',
  industry: 'M3 21V10l5 3V10l5 3V6l7 4v11H3Z',
  grade: 'M12 1.5 21 12 12 22.5 3 12Z',
};

// Same scalloped-seal motif used on the Quality & Certificates page — a
// traditional "wax seal" reads consistently as this site's mark of trust.
const petals = Array.from({ length: 12 }, (_, i) => {
  const angle = (i / 12) * Math.PI * 2;
  return { cx: 32 + Math.cos(angle) * 21, cy: 32 + Math.sin(angle) * 21 };
});


const infoIcons: Record<string, string> = {
  Email: 'M8 12h16v10H8Z M8 12l8 6 8-6',
  'Head Office': 'M16 6C12.13 6 9 9.13 9 13c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Z M16 15.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  'Factory Address': 'M7 9h18v13a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V9Z M12 9V7a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M7 15h18',
};

// One glyph per inquiry role — reused as both the quick-nav tab icon and the
// small seal badge preceding each section's heading, so the two stay tied together.
const roleIcons: Record<string, string> = {
  general: 'M8 10h.01M12 10h.01M16 10h.01 M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 0 1-4-.8L3 20l1.3-3.9A7.9 7.9 0 0 1 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z',
  industrial: 'M3 21V10l5 3V10l5 3V6l7 4v11H3Z',
  distributor: 'M7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z M17 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z M12 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z M7 8l4.2 9M17 8l-4.2 9',
  // A speech bubble with a "?" (not the plain-dots bubble already used for
  // "general") — this tab is about asking a question of/about a distributor,
  // distinct from a general inquiry.
  'connect-distributor': 'M9 9a3 3 0 1 1 3 3c-1 0-1.5 0.7-1.5 1.5 M12 16h.01 M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 0 1-4-.8L3 20l1.3-3.9A7.9 7.9 0 0 1 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z',
  'export': 'M3 17h18l-2 4H5l-2-4Z M6 17V9l6-4 6 4v8 M10 17v-5h4v5',
};
---

<main class="bg-silent-white">
  <!-- Hero — deep red with the same faint pinstripe texture used across the business pages -->
  <section class="relative overflow-hidden bg-indian-red py-16 lg:py-24 text-center">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.05]"
      style="background-image: repeating-linear-gradient(90deg, #FFF6EB 0, #FFF6EB 1px, transparent 1px, transparent 28px);"
      aria-hidden="true"
    />
    <div class="relative max-w-[900px] mx-auto px-6 lg:px-10">
      <h1 class="reveal font-display font-medium text-4xl lg:text-6xl text-silent-white leading-tight" data-cms-field="hero.title">
        {hero.title}
      </h1>
      <p class="reveal mt-6 text-base lg:text-lg leading-relaxed text-silent-white/75 max-w-[680px] mx-auto" style="transition-delay: 80ms" data-cms-field="hero.intro">
        {hero.intro}
      </p>
    </div>

    <svg class="absolute bottom-0 inset-x-0 z-10 w-full h-14 sm:h-20 lg:h-28 text-silent-white" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M0,130 C120,70 240,190 360,130 C480,70 600,190 720,130 C840,70 960,190 1080,130 C1200,70 1320,190 1440,130 L1440,200 L0,200 Z"
        fill="currentColor"
      />
    </svg>
  </section>

  <!-- Contact info — seal-badge cards -->
  <section class="relative max-w-[1100px] mx-auto px-6 lg:px-10 pt-10 lg:pt-16">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.05] [mask-image:linear-gradient(to_bottom,black,transparent)]"
      style="background-image: repeating-linear-gradient(90deg, #A82121 0, #A82121 1px, transparent 1px, transparent 28px);"
      aria-hidden="true"
    />
    <div class="relative">
      <h2 class="reveal font-display font-medium text-2xl lg:text-3xl text-indian-red mb-8" data-cms-field="info.heading">
        {info.heading}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {info.items.map((item, ii) => (
          <div
            class="info-card reveal group rounded-2xl bg-white p-6 ring-1 ring-indian-red/[0.08] transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-xl hover:shadow-indian-red/10 hover:ring-indian-red/20"
            style={`transition-delay: ${ii * 70}ms`}
          >
            <svg viewBox="0 0 64 64" class="info-icon h-12 w-12 text-indian-red">
              {petals.map((p) => (
                <circle cx={p.cx} cy={p.cy} r="8" fill="currentColor" opacity="0.85" />
              ))}
              <circle cx="32" cy="32" r="16" fill="currentColor" />
              <path
                d={infoIcons[item.label] ?? ''}
                fill="none"
                stroke="#FFF6EB"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                transform="scale(1.3) translate(8.6, 8.6)"
              />
            </svg>
            <p class="mt-4 text-[10px] font-semibold uppercase tracking-widest text-indian-red/40" data-cms-field={`info.items[${ii}].label`}>
              {item.label}
            </p>
            <p class="mt-1 font-display font-medium text-lg text-indian-red" data-cms-field={`info.items[${ii}].value`}>
              {item.href ? (
                <a
                  href={item.href}
                  target={item.href.startsWith('mailto:') ? undefined : '_blank'}
                  rel={item.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                  class="hover:underline"
                >
                  {item.value}
                </a>
              ) : (
                item.value
              )}
            </p>
            <p class="mt-2 text-sm leading-relaxed text-indian-red/70" data-cms-field={`info.items[${ii}].description`}>
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick-nav — switches which inquiry form is shown below -->
  <section class="sticky top-0 z-30 bg-white/90 backdrop-blur-sm border-b border-indian-red/10 mt-10 lg:mt-16">
    <nav class="max-w-[1100px] mx-auto px-6 lg:px-10">
      <ul id="contact-nav" role="tablist" class="relative flex gap-1 overflow-x-auto no-scrollbar py-2">
        <li id="nav-indicator" class="absolute -z-10 top-1 bottom-1 left-0 rounded-full bg-indian-red/10" style="width: 0" aria-hidden="true"></li>
        {nav.items.map((item, ni) => (
          <li class="shrink-0" role="presentation">
            <button
              type="button"
              id={`tab-${item.id}`}
              role="tab"
              aria-selected={ni === 0 ? 'true' : 'false'}
              aria-controls={`panel-${item.id}`}
              data-tab={item.id}
              class={`nav-pill flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium text-indian-red/55 transition-colors duration-200 hover:text-indian-red hover:bg-indian-red/5 ${ni === 0 ? 'active' : ''}`}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0"><path d={roleIcons[item.id] ?? ''} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span data-cms-field={`nav.items[${ni}].label`}>{item.label}</span>
            </button>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- General Inquiry -->
  <section id="panel-general" role="tabpanel" aria-labelledby="tab-general" data-panel="general" class="contact-panel active relative py-10 lg:py-16">
    <div class="relative max-w-[900px] mx-auto px-6 lg:px-10">
      <div class="reveal flex items-center gap-3">
        <svg viewBox="0 0 64 64" class="panel-seal h-10 w-10 shrink-0 text-indian-red">
          {petals.map((p) => <circle cx={p.cx} cy={p.cy} r="8" fill="currentColor" opacity="0.85" />)}
          <circle cx="32" cy="32" r="16" fill="currentColor" />
          <path d={roleIcons.general} fill="none" stroke="#FFF6EB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" transform="scale(1.3) translate(12.6, 12.6)" />
        </svg>
        <h2 class="font-display font-medium text-2xl lg:text-3xl text-indian-red" data-cms-field="general.heading">
          {general.heading}
        </h2>
      </div>
      <p class="reveal mt-3 text-sm leading-relaxed text-indian-red/70 max-w-[600px]" style="transition-delay: 60ms" data-cms-field="general.subheading">
        {general.subheading}
      </p>

      <form id="general-form" class="reveal mt-8 overflow-hidden rounded-2xl bg-white shadow-lg shadow-indian-red/10 ring-1 ring-indian-red/[0.08] lg:grid lg:grid-cols-[260px_1fr]" style="transition-delay: 120ms">
        <div class="relative overflow-hidden bg-indian-red p-6 lg:p-8 flex flex-col justify-between">
          <div class="pointer-events-none absolute inset-0 opacity-[0.06]" style="background-image: repeating-linear-gradient(90deg, #FFF6EB 0, #FFF6EB 1px, transparent 1px, transparent 28px);" aria-hidden="true" />
          <div class="relative">
            <span class="font-display text-[10px] font-medium uppercase tracking-widest text-silent-white/50" data-cms-field="general.card.ref">{general.card.ref}</span>
            <h3 class="mt-2 font-display font-medium text-xl text-silent-white" data-cms-field="general.card.title">{general.card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-silent-white/70" data-cms-field="general.card.body">
              {general.card.body}
            </p>
          </div>
          <p class="relative mt-8 text-xs text-silent-white/50" data-cms-field="general.card.note">{general.card.note}</p>
        </div>

        <div class="p-6 lg:p-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="general.fields.name">{general.fields.name}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M4 20c0-4 4-6 8-6s8 2 8 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <input type="text" name="name" required class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder={t(locale, 'Your name')} />
              </div>
            </label>
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="general.fields.email">{general.fields.email}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M3 5h18v14H3V5Z M3 5l9 8 9-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                <input type="email" name="email" required class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder="you@example.com" />
              </div>
            </label>
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="general.fields.city">{general.fields.city}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><circle cx="12" cy="9" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
                <input type="text" name="city" required class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder="e.g. Ahmedabad" />
              </div>
            </label>
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="general.fields.state">{general.fields.state}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><circle cx="12" cy="9" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
                <input type="text" name="state" required class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder="e.g. Gujarat" />
              </div>
            </label>
            <label class="block sm:col-span-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="general.fields.subject">{general.fields.subject}</span>
              <div class="relative mt-1.5">
                <CustomSelect client:visible name="subject" placeholder={t(locale, 'Select a reason')} options={general.subjectOptions} icon={ICONS.subject} listPath="general.subjectOptions" required />
              </div>
            </label>
            <label class="block sm:col-span-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="general.fields.message">{general.fields.message}</span>
              <textarea name="message" required rows="4" class="mt-1.5 w-full rounded-lg border border-indian-red/15 bg-white px-3.5 py-2.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder={t(locale, 'Tell us what\'s on your mind')}></textarea>
            </label>
          </div>

          <button id="general-submit" type="submit" class="mt-7 inline-flex items-center justify-center gap-2 rounded-full bg-indian-red px-6 py-3 text-sm font-medium text-silent-white transition-transform duration-200 hover:scale-[1.03] disabled:opacity-70 disabled:cursor-not-allowed disabled:hover:scale-100">
            <span id="general-submit-label" data-cms-field="general.submitLabel">{general.submitLabel}</span>
            <svg viewBox="0 0 24 24" class="h-4 w-4"><path d="M5 12h14m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>

          <p id="general-success" class="mt-4 hidden text-sm font-medium text-indian-red" data-cms-field="general.successMessage">{general.successMessage}</p>
          <p id="general-error" class="mt-4 hidden text-sm font-medium text-red-600"></p>
        </div>
      </form>
    </div>
  </section>

  <!-- Bulk & Industrial Inquiry — same fields as the Industrial Salt RFQ form -->
  <section id="panel-industrial" role="tabpanel" aria-labelledby="tab-industrial" data-panel="industrial" class="contact-panel relative py-10 lg:py-16">
    <div class="pointer-events-none absolute inset-0 opacity-[0.05] [mask-image:linear-gradient(to_bottom,black,transparent)]" style="background-image: repeating-linear-gradient(90deg, #A82121 0, #A82121 1px, transparent 1px, transparent 28px);" aria-hidden="true" />
    <div class="relative max-w-[900px] mx-auto px-6 lg:px-10">
      <div class="reveal flex items-center gap-3">
        <svg viewBox="0 0 64 64" class="panel-seal h-10 w-10 shrink-0 text-indian-red">
          {petals.map((p) => <circle cx={p.cx} cy={p.cy} r="8" fill="currentColor" opacity="0.85" />)}
          <circle cx="32" cy="32" r="16" fill="currentColor" />
          <path d={roleIcons.industrial} fill="none" stroke="#FFF6EB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" transform="scale(1.3) translate(12.6, 12.6)" />
        </svg>
        <h2 class="font-display font-medium text-2xl lg:text-3xl text-indian-red" data-cms-field="industrial.heading">
          {industrial.heading}
        </h2>
      </div>
      <p class="reveal mt-3 text-sm leading-relaxed text-indian-red/70 max-w-[600px]" style="transition-delay: 60ms" data-cms-field="industrial.subheading">
        {industrial.subheading}
      </p>
      <a href={industrial.linkHref} class="reveal group mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-indian-red underline decoration-indian-red/30 underline-offset-4 transition-colors hover:decoration-indian-red" style="transition-delay: 90ms" data-cms-link="industrial.linkHref">
        <span data-cms-field="industrial.linkLabel">{industrial.linkLabel}</span>
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5"><path d="M5 12h14m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>

      <form id="industrial-form" class="reveal mt-8 overflow-hidden rounded-2xl bg-white shadow-lg shadow-indian-red/10 ring-1 ring-indian-red/[0.08] lg:grid lg:grid-cols-[260px_1fr]" style="transition-delay: 130ms">
        <div class="relative overflow-hidden bg-indian-red p-6 lg:p-8 flex flex-col justify-between">
          <div class="pointer-events-none absolute inset-0 opacity-[0.06]" style="background-image: repeating-linear-gradient(90deg, #FFF6EB 0, #FFF6EB 1px, transparent 1px, transparent 28px);" aria-hidden="true" />
          <div class="relative">
            <span class="font-display text-[10px] font-medium uppercase tracking-widest text-silent-white/50" data-cms-field="industrial.card.ref">{industrial.card.ref}</span>
            <h3 class="mt-2 font-display font-medium text-xl text-silent-white" data-cms-field="industrial.card.title">{industrial.card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-silent-white/70" data-cms-field="industrial.card.body">
              {industrial.card.body}
            </p>
          </div>
          <p class="relative mt-8 text-xs text-silent-white/50" data-cms-field="industrial.card.note">{industrial.card.note}</p>
        </div>

        <div class="p-6 lg:p-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="industrial.fields.company">{industrial.fields.company}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M4 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16M13 21h7V11a1 1 0 0 0-1-1h-6M8 8h1M8 12h1M8 16h1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <input type="text" name="company" required class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder={t(locale, 'Your company')} />
              </div>
            </label>
            <label class="block">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50" data-cms-field="industrial.fields.industry">{industrial.fields.industry}</span>
              <div class="relative mt-1.5">
                <CustomSelect client:visible name="industry" placeholder={t(locale, 'Select industry')} options={[...productOptions.industries, 'Other']} icon={ICONS.industry} listPath="productOptions.industries" required />
              </div>
            </label>
            <label id="contact-industrial-other-wrap" class="hidden sm:col-span-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-indian-red/50">{t(locale, 'Please specify your industry')}</span>
              <div class="relative mt-1.5">
                <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-indian-red/35"><path d="M3 21V10l5 3V10l5 3V6l7 4v11H3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                <input type="text" id="contact-industrial-other" name="industryOther" class="w-full rounded-lg border border-indian-red/15 bg-white py-2.5 pl-10 pr-3.5 text-sm text-indian-red placeholder:text-indian-red/30 transition-colors duration-150 hover:border-indian-red/30 focus:outline-none focus:ring-2 focus:ring-indian-red/30" placeholder="e.g. Cosmetics manufacturing" />
              </div>
