---
interface ChecklistItem { title: string; description: string }
interface Props {
  section: { heading: string; items: ChecklistItem[] };
  si: number;
}
const { section, si } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  {section.items.map((item, ii) => (
    <div
      class="reveal group flex gap-4 rounded-lg bg-white p-5 lg:p-6 ring-1 ring-indian-red/[0.08] transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-lg hover:shadow-indian-red/10 hover:ring-indian-red/20"
      style={`transition-delay: ${ii * 70}ms`}
    >
      <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-indian-red/10 text-indian-red transition-colors duration-300 group-hover:bg-indian-red group-hover:text-silent-white">
        <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none">
          <path d="M4 10.5 L8 14.5 L16 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <div>
        <p class="font-display font-medium text-base text-indian-red" data-cms-field={`detail.sections[${si}].items[${ii}].title`}>
          {item.title}
        </p>
        <p class="mt-1 text-sm leading-relaxed text-indian-red/70" data-cms-field={`detail.sections[${si}].items[${ii}].description`}>
          {item.description}
        </p>
      </div>
    </div>
  ))}
</div>
