---
import { PortableText } from 'emdash/ui';
import { mobileVariant } from '../lib/mobileImage';
import BlogLink from './blog-sections/BlogLink.astro';

const components = { mark: { link: BlogLink } };
import type { BlogPost, BlogContent } from './BlogList.astro';

interface Props {
  content: BlogContent;
  posts: BlogPost[];
  slug: string;
}

const { content, posts, slug } = Astro.props;
const { labels, categoryColors, defaultCategoryColor } = content;
const post = posts.find((p) => p.slug === slug);
const postIdx = posts.findIndex((p) => p.slug === slug);
const others = post ? posts.filter((p) => p.slug !== slug).slice(0, 2) : [];

// The old site's stat rows are stored as two-row tables in the article (see
// blog-rich-text.mjs, which keys their rows `…-row-1`/`…-row-2`). Show them as
// the stat cards they were; in edit mode the editor keeps them as tables.
type Block = { _type: string; rows?: { _key: string; cells: { content?: { text?: string }[] }[] }[] };
const cellText = (cell: { content?: { text?: string }[] }) => (cell.content ?? []).map((span) => span.text ?? '').join('');
const isStatRow = (block: Block) => block._type === 'table' && block.rows?.length === 2
  && /-row-1$/.test(block.rows[0]._key) && /-row-2$/.test(block.rows[1]._key);
const editing = !!post && !!Object.getOwnPropertyDescriptor(post.content, Symbol.for('__emdash'));
const segments: ({ blocks: Block[] } | { stats: { label: string; value: string }[] })[] = [];
for (const block of (post?.content ?? []) as Block[]) {
  if (isStatRow(block)) {
    const [labels, values] = block.rows!;
    segments.push({ stats: labels.cells.map((cell, i) => ({ label: cellText(cell), value: cellText(values.cells[i]) })) });
  } else {
    const last = segments.at(-1);
    if (last && 'blocks' in last) last.blocks.push(block);
    else segments.push({ blocks: [block] });
  }
}
---
{post && (
  <main class="bg-gradient-to-b from-silent-white to-white"><!-- Hero — deep red, same faint pinstripe texture used across the site --><section class="relative overflow-hidden bg-indian-red pt-16 lg:pt-24 pb-0"><div
        class="pointer-events-none absolute inset-0 opacity-[0.05]"
        style="background-image: repeating-linear-gradient(90deg, #FFF6EB 0, #FFF6EB 1px, transparent 1px, transparent 28px);"
        aria-hidden="true"
      /><div class="relative max-w-[900px] mx-auto px-6 lg:px-10 pb-14"><div class="reveal flex flex-wrap items-center gap-3 mb-6 pt-8" style="transition-delay: 60ms"><span
            class="rounded-full px-3 py-1 text-[9px] font-bold uppercase tracking-[0.2em] text-silent-white"
            style={`background: ${categoryColors[post.category] ?? defaultCategoryColor}`}
            data-cms-field={`[${postIdx}].category`}
          >{post.category}</span><span class="text-[11px] text-silent-white/50"><span data-cms-field={`[${postIdx}].readTime`}>{post.readTime}</span><span data-cms-field="labels.minReadSuffix">{labels.minReadSuffix}</span></span><span class="text-[11px] text-silent-white/50" data-cms-field={`[${postIdx}].publishedAt`}>{post.publishedAt}</span></div><h1
          class="reveal font-display font-medium text-3xl lg:text-5xl leading-tight text-silent-white max-w-3xl"
          style="transition-delay: 100ms"
          data-cms-field={`[${postIdx}].title`}
        >{post.title}</h1></div>{post.imageUncropped ? (<div class="reveal relative w-full overflow-hidden" style="transition-delay: 140ms;" data-cms-image={`[${postIdx}].image`}><picture>{mobileVariant(post.image) && <source media="(max-width: 1023px)" srcset={mobileVariant(post.image)} type="image/webp" />}<img src={post.image} alt={post.imageAlt} class="block h-auto w-full" fetchpriority="high" /></picture></div>) : (<div class="reveal relative w-full overflow-hidden" style="transition-delay: 140ms; height: clamp(220px, 34vw, 440px);" data-cms-image={`[${postIdx}].image`}><picture>{mobileVariant(post.image) && <source media="(max-width: 1023px)" srcset={mobileVariant(post.image)} type="image/webp" />}<img src={post.image} alt={post.imageAlt} width={1920} height={1280} class="h-full w-full object-cover" fetchpriority="high" /></picture><div class="absolute inset-0 bg-gradient-to-t from-indian-red via-transparent to-transparent" /></div>)}</section><!-- Article body --><section class="relative py-16 lg:py-20"><div class="relative max-w-[720px] mx-auto px-6 lg:px-10"><div class="reveal" style="transition-delay: 180ms"><div class="article-body">{editing ? <PortableText value={post.content} components={components} /> : segments.map((segment) => 'stats' in segment ? (<div class="my-10 grid grid-cols-1 sm:grid-cols-3 gap-4 rounded-2xl bg-indian-red/[0.04] p-6 ring-1 ring-indian-red/[0.08]">{segment.stats.map((stat) => (<div class="text-center sm:text-left sm:border-l sm:first:border-l-0 sm:border-indian-red/10 sm:pl-6 sm:first:pl-0"><div class="font-display font-semibold text-2xl lg:text-3xl text-indian-red">{stat.value}</div><div class="mt-1 text-xs font-medium uppercase tracking-wide text-indian-red/50">{stat.label}</div></div>))}</div>) : <PortableText value={segment.blocks} components={components} />)}</div></div><div class="mt-16 pt-10 border-t border-indian-red/10"><a
            href={labels.blogHref}
            data-cms-link="labels.blogHref"
            class="inline-flex items-center gap-2 text-sm font-medium text-indian-red transition-all duration-200 hover:gap-3"
          ><span aria-hidden="true">&larr;</span><span data-cms-field="labels.backToAllArticles">{labels.backToAllArticles}</span></a></div></div></section><!-- More From the Blog — same editorial index-row language as the blog index, not a repeated card grid -->{others.length > 0 && (
      <section class="relative bg-indian-red/[0.04] py-16 lg:py-20"><div class="relative max-w-[900px] mx-auto px-6 lg:px-10"><span class="reveal block mb-6 text-[10px] font-semibold uppercase tracking-widest text-indian-red/40" data-cms-field="labels.moreArticles">{labels.moreArticles}</span><div>{others.map((p, oi) => (
              <a
                href={`${labels.blogHref}${p.slug}/`}
                class="reveal group flex items-start gap-5 sm:gap-8 border-b border-indian-red/10 py-7 first:pt-0 last:border-b-0"
                style={`transition-delay: ${oi * 70}ms`}
              ><div class="h-20 w-20 sm:h-28 sm:w-28 shrink-0 overflow-hidden rounded-xl"><img src={p.image} alt={p.imageAlt} width={1920} height={1280} class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.06]" loading="lazy" /></div><div class="min-w-0 flex-1"><div class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-1"><span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background: ${categoryColors[p.category] ?? defaultCategoryColor}`} aria-hidden="true" /><span class="text-[10px] font-semibold uppercase tracking-[0.14em]" style={`color: ${categoryColors[p.category] ?? defaultCategoryColor}`} data-cms-field={`[${posts.indexOf(p)}].category`}>{p.category}</span><span class="text-indian-red/20">&middot;</span><span class="text-[11px] text-indian-red/45" data-cms-field={`[${posts.indexOf(p)}].publishedAt`}>{p.publishedAt}</span></div><h3 class="font-display font-medium text-lg leading-snug text-indian-red mb-1.5" data-cms-field={`[${posts.indexOf(p)}].title`}>{p.title}</h3><span class="inline-flex items-center gap-1.5 text-sm font-medium text-indian-red transition-all duration-200 group-hover:gap-2.5"><span data-cms-field="labels.readArticle">{labels.readArticle}</span><span aria-hidden="true">&rarr;</span></span></div></a>
            ))}</div></div></section>
    )}</main>
)}<style>
  .article-body :global(p) { color: rgb(168 33 33 / 0.8); line-height: 1.75; margin-bottom: 1.25rem; font-size: 1.0625rem; }
  .article-body > :global(p:first-child) { color: rgb(168 33 33 / 0.9); }
  .article-body :global(h2) { font-family: var(--font-display); font-weight: 500; color: rgb(168 33 33); font-size: 1.5rem; line-height: 2rem; margin: 3rem 0 1.25rem; }
  @media (min-width: 1024px) { .article-body :global(h2) { font-size: 1.875rem; line-height: 2.25rem; } }
  .article-body :global(h3) { font-size: 0.875rem; line-height: 1.25rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.025em; color: rgb(168 33 33 / 0.7); margin: 2rem 0 0.75rem; }
  .article-body :global(h4), .article-body :global(h5), .article-body :global(h6) { margin: 1.5rem 0 0.75rem; }
  .article-body :global(ul), .article-body :global(ol) { margin-bottom: 1.5rem; color: rgb(168 33 33 / 0.8); }
  .article-body :global(ol) { padding-left: 1.5rem; }
  .article-body :global(ul) { list-style: none; padding-left: 0; }
  .article-body :global(ul > li) { position: relative; padding-left: 1.125rem; font-size: 1.0625rem; line-height: 1.625; }
  .article-body :global(ul > li)::before { content: ''; position: absolute; left: 0; top: 0.625rem; width: 0.375rem; height: 0.375rem; border-radius: 9999px; background: rgb(168 33 33 / 0.5); }
  .article-body :global(ol) { list-style: decimal; }
  .article-body :global(li) { margin-bottom: 0.625rem; line-height: 1.75; }
  .article-body :global(ul > li:last-child) { margin-bottom: 0; }
  .article-body :global(blockquote) { border-left: 3px solid rgb(168 33 33 / 0.3); padding-left: 1.5rem; margin: 2.5rem 0; }
  .article-body :global(a) { text-decoration: underline; text-decoration-color: rgb(168 33 33 / 0.3); text-underline-offset: 2px; }
  .article-body :global(a:hover) { text-decoration-color: rgb(168 33 33); }
  .article-body :global(img) { max-width: 100%; height: auto; border-radius: 0.75rem; }
  .article-body :global(pre) { overflow-x: auto; padding: 1rem; margin-bottom: 1.5rem; }
  .article-body :global(th), .article-body :global(td) { border-color: rgb(168 33 33 / 0.15); }
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style><script>
  // initReveal runs on `astro:page-load` (fires on initial load AND every
  // client-side transition) rather than as plain top-level code — this
  // <script> is a JS module, and modules only ever execute once per browser
  // session, so a plain top-level run left every `.reveal` element
  // permanently invisible on any revisit later in the same session
  // (including navigating between two different blog posts, which is the
  // same URL pattern re-rendered with new props). revealObserver is
  // disconnected at the top of each run so a revisit replaces it instead of
  // layering a second observer on top.
  let revealObserver: IntersectionObserver | null = null;

  function initReveal(): void {
    revealObserver?.disconnect();
    const targets = document.querySelectorAll<HTMLElement>('.reveal');
    if (!targets.length) return;
    revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            revealObserver?.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );
    targets.forEach((el) => revealObserver?.observe(el));
  }

  document.addEventListener('astro:page-load', initReveal);
</script>