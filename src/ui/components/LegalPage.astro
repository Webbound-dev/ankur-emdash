---
interface Section {
  heading: string;
  paragraphs: string[];
}

interface Props {
  content: {
    title: string;
    lastUpdated: string;
    intro: string;
    sections: Section[];
  };
}

const { content } = Astro.props;

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// Legal copy (privacy/terms) routinely tells readers to email a specific
// address — this turns any email address found in a paragraph into a real
// mailto: link instead of inert text, without requiring the content itself
// to be restructured into separate fields.
const EMAIL_RE = /[\w.-]+@[\w.-]+\.\w+/;
const linkifyEmails = (text: string) =>
  text.split(new RegExp(`(${EMAIL_RE.source})`, 'g')).map((part) => ({ part, isEmail: EMAIL_RE.test(part) }));

const sections = content.sections.map((section) => ({
  ...section,
  id: slugify(section.heading),
}));
---

<main class="bg-silent-white">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-10 py-16 lg:py-24">
    <!-- Header -->
    <div class="max-w-[720px]">
      <p class="text-[10px] font-semibold uppercase tracking-widest text-indian-red/50">
        Last updated: <span data-cms-field="lastUpdated">{content.lastUpdated}</span>
      </p>
      <h1 class="mt-3 font-display font-medium text-3xl lg:text-5xl text-indian-red leading-tight" data-cms-field="title">
        {content.title}
      </h1>
      <p class="mt-5 text-sm leading-relaxed text-indian-red/70" data-cms-field="intro">
        {content.intro}
      </p>
    </div>

    <!-- Sidebar + content -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-x-16 gap-y-10">
      <!-- Sidebar nav — horizontally scrollable pill row on mobile, sticky vertical list on desktop -->
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <span class="hidden lg:block text-[10px] font-semibold uppercase tracking-widest text-indian-red/40">On this page</span>
        <nav
          id="legal-toc"
          class="mt-0 lg:mt-4 flex gap-2 overflow-x-auto pb-3 lg:pb-0 lg:flex-col lg:gap-0 lg:overflow-visible lg:border-l lg:border-indian-red/10 scrollbar-hide"
        >
          {sections.map((section, si) => (
            <a
              href={`#${section.id}`}
              data-toc-link={section.id}
              class="toc-link relative shrink-0 whitespace-nowrap rounded-full border border-indian-red/15 px-3.5 py-1.5 text-xs text-indian-red/60 transition-colors duration-200 hover:text-indian-red lg:rounded-none lg:border-0 lg:border-l-2 lg:border-transparent lg:-ml-px lg:whitespace-normal lg:px-5 lg:py-2.5 lg:text-sm lg:text-indian-red/55"
            >
              <span data-cms-field={`sections[${si}].heading`}>{section.heading}</span>
            </a>
          ))}
        </nav>
      </aside>

      <!-- Sections -->
      <div class="space-y-14 max-w-[680px]">
        {sections.map((section, si) => (
          <section id={section.id} class="scroll-mt-28 rounded-2xl bg-white/60 ring-1 ring-indian-red/[0.06] p-6 lg:p-8">
            <h2
              class="font-display font-medium text-xl text-indian-red mb-4"
              data-cms-field={`sections[${si}].heading`}
            >
              {section.heading}
            </h2>
            <div class="space-y-3">
              {section.paragraphs.map((p, pi) => (
                <p
                  class="text-sm leading-relaxed text-indian-red/75"
                  data-cms-field={`sections[${si}].paragraphs[${pi}]`}
                >
                  {linkifyEmails(p).map(({ part, isEmail }) =>
                    isEmail ? (
                      <a href={`mailto:${part}`} class="underline decoration-indian-red/30 underline-offset-2 hover:decoration-indian-red">{part}</a>
                    ) : (
                      part
                    )
                  )}
                </p>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</main>

<style>
  .toc-link.active {
    color: var(--color-indian-red);
    border-color: var(--color-indian-red);
    background: color-mix(in srgb, var(--color-indian-red) 6%, transparent);
    font-weight: 500;
  }
  @media (min-width: 1024px) {
    .toc-link.active {
      background: transparent;
    }
  }
  .scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // initLegalPage runs on `astro:page-load` (fires on initial load AND every
  // client-side transition) rather than as plain top-level code — this
  // <script> is a JS module, and modules only ever execute once per browser
  // session, so a plain top-level run left the toc-highlighting observer
  // never attached on any page revisited later in the same session. tocObserver
  // is disconnected at the top of each run so a revisit replaces it instead
  // of layering a second observer on top.
  let tocObserver: IntersectionObserver | null = null;

  function initLegalPage(): void {
    tocObserver?.disconnect();

    // Highlights the current section's link in the sidebar table-of-contents as you scroll.
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const sections = Array.from(links)
      .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => !!el);

    if (sections.length && links.length) {
      tocObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            links.forEach((link) => link.classList.toggle('active', link.dataset.tocLink === entry.target.id));
          }
        },
        { rootMargin: '-30% 0px -60% 0px', threshold: 0 }
      );
      sections.forEach((section) => tocObserver?.observe(section));
    }
  }

  document.addEventListener('astro:page-load', initLegalPage);
</script>
