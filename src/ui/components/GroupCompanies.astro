---
export interface GroupCompany { name: string; industry: string; description: string; website?: string }

interface Props {
  heading: string;
  companies: GroupCompany[];
  // CMS field paths into the *calling page's* own content JSON — this
  // component doesn't assume its own content location, since it's reused
  // across pages (About page's "group" section, the dedicated Champalal
  // Group page) that each store this data at a different JSON path.
  headingField: string;
  companiesField: string;
  // Optional — the About page links out to the dedicated Champalal Group
  // page from here; that dedicated page itself doesn't pass this (it would
  // just be a link back to itself).
  cta?: { label: string; href: string };
  ctaField?: string;
}

const { heading, companies, headingField, companiesField, cta, ctaField } = Astro.props;

// Same wave silhouette used for the dark/light handoffs on the product
// detail page (see ProductDetail.astro's WAVE_PATH) — reused verbatim here
// so both wavy dividers on the site read as one consistent language.
const WAVE_PATH = 'M0,20 C180,90 360,0 540,50 C720,100 900,10 1080,55 C1260,100 1350,40 1440,60 L1440,120 L0,120 Z';
---
{/* Group companies — its own full-bleed section: white cards floating
       on a solid red background, same color treatment as this site's other
       dark bands. Only a bottom wave hands off to whatever section follows
       — no top wave, since a caller may place this right after a section
       that ends in a photo (About page), where an overlapping wave would
       cut across it. Texture/glows live in their own clipped layer,
       separate from the section itself, so the bottom wave (which
       deliberately renders outside the section's own box) isn't clipped
       along with them. No pinstripe texture either — it would visibly stop
       at this section's flat edge instead of continuing into the curved
       wave below, since the wave is a separate rotated/translated SVG that
       can't share the same CSS background pattern without a seam. */}{companies.length > 0 && (
  <section class="relative bg-indian-red py-14 lg:py-20"><div class="absolute inset-0 overflow-hidden" aria-hidden="true"><div class="absolute -top-16 -right-24 h-72 w-72 rounded-full bg-silent-white/[0.06] blur-3xl" /><div class="absolute -bottom-20 -left-16 h-80 w-80 rounded-full bg-silent-white/[0.06] blur-3xl" /></div><div class="absolute bottom-0 left-0 w-full leading-none translate-y-[calc(100%-2px)] rotate-180" aria-hidden="true"><svg viewBox="0 0 1440 120" class="block w-full h-[48px] lg:h-[90px]" preserveAspectRatio="none"><path d={WAVE_PATH} fill="#A82121" /></svg></div><div class="relative max-w-[1100px] mx-auto px-6 lg:px-10"><h2 class="reveal font-display font-medium text-2xl lg:text-3xl text-silent-white mb-8 lg:mb-10" data-cms-field={headingField}>{heading}</h2><!-- Two columns, not three — three left an odd company count (this
           list currently has 4) stranded alone in a mostly-empty final row.
           A lone leftover on an odd count still spans the full width below
           instead of sitting half-empty next to nothing. --><div class="grid grid-cols-1 sm:grid-cols-2 gap-5">{companies.map((company, ci) => (
          <div
            class={`reveal group relative flex flex-col overflow-hidden rounded-2xl bg-white p-6 shadow-lg shadow-black/10 transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-black/20 ${
              companies.length % 2 === 1 && ci === companies.length - 1 ? 'sm:col-span-2' : ''
            }`}
            style={`transition-delay: ${ci * 60}ms`}
          ><div
              class="absolute inset-x-0 top-0 h-1 bg-indian-red/15 transition-colors duration-300 group-hover:bg-indian-red/50"
              aria-hidden="true"
            /><span
              class="inline-block self-start rounded-full bg-indian-red/[0.06] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-indian-red/60"
              data-cms-field={`${companiesField}[${ci}].industry`}
            >{company.industry}</span><p class="mt-3 font-display font-medium text-xl text-indian-red" data-cms-field={`${companiesField}[${ci}].name`}>{company.name}</p><p
              class="mt-2 line-clamp-3 text-sm leading-relaxed text-indian-red/70"
              data-cms-field={`${companiesField}[${ci}].description`}
              data-company-description
            >{company.description}</p><button type="button" class="read-more-toggle mt-1 hidden self-start text-xs font-semibold text-indian-red/70 hover:text-indian-red"> Read more </button>{company.website && (
              <a
                href={company.website}
                target="_blank"
                rel="noopener noreferrer"
                data-cms-link={`${companiesField}[${ci}].website`}
                class="mt-auto pt-3 inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-indian-red hover:underline"
              > Visit Website <span aria-hidden="true">→</span></a>
            )}</div>
        ))}</div>{cta && ctaField && (
        <a
          href={cta.href}
          data-cms-link={`${ctaField}.href`}
          class="reveal group mt-10 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-medium text-indian-red transition-opacity duration-200 hover:opacity-90"
        ><span data-cms-field={`${ctaField}.label`}>{cta.label}</span><span class="transition-transform duration-200 group-hover:translate-x-1">→</span></a>
      )}</div></section>
)}<style is:global>
  /* Astro scopes <style> per-component, so a caller's own .reveal rule
     (e.g. AboutUs.astro's) never reaches elements rendered by this child
     component — this is:global block is what actually makes the fade-in
     work here. The IntersectionObserver that adds .in-view lives in
     whichever page renders this component (it queries the whole document,
     so it picks these elements up regardless of which file rendered them);
     only the CSS needed its own copy. */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>